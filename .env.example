# ── General ──────────────────────────────────────────────
ENV=development
DEBUG=true
APP_NAME="VeriIA Ecuador API"
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
PORT=8000

# ── Seguridad ────────────────────────────────────────────
# IMPORTANTE: cámbialo en producción (genera uno con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ─────────────────────────────────────────────────
# "*" o lista separada por comas, ej: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=*

# ── Base de datos ────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://veriia:veriia_dev@localhost:5432/veriia

# ── Archivos ─────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── IA ───────────────────────────────────────────────────
# Proveedor IA: mock | ollama | openai | google
AI_PROVIDER=mock
AI_ENABLED=true
AI_TIMEOUT_SECONDS=60

# Ollama (local, recomendado para desarrollo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava

# OpenAI / compatible (OpenRouter, Azure, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Google AI (Gemini) — listo para conexión: define GOOGLE_AI_API_KEY y usa AI_PROVIDER=google
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_AI_TEXT_MODEL=gemini-2.0-flash
GOOGLE_AI_VISION_MODEL=gemini-2.0-flash

# ── Tareas asíncronas ────────────────────────────────────
# inline | celery
WORKER_BACKEND=inline
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
WORKER_CONCURRENCY=2

# ── Admin inicial (seed) ─────────────────────────────────
# python -m app.scripts.seed_admin
ADMIN_EMAIL=admin@veriia.ec
ADMIN_FULL_NAME=Administrador
ADMIN_PASSWORD=
