# ?????? General ??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
ENV=development
DEBUG=true
APP_NAME="VeriIA Ecuador API"
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
PORT=3008

# ?????? CORS ???????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
# "*" o lista separada por comas, ej: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=*

# ?????? IA ?????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
# Proveedor IA: mock | ollama | openai | google
AI_PROVIDER=mock
AI_ENABLED=true
AI_TIMEOUT_SECONDS=60

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_VISION_MODEL=llava

# OpenAI / compatible (OpenRouter, Azure, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Google AI (Gemini) ??? para VeriIA Bot y an??lisis con IA real:
# 1) Crea una clave en https://aistudio.google.com/apikey
# 2) P??gala abajo
# 3) Reinicia el backend (pnpm run dev)
GOOGLE_AI_API_KEY=
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_AI_TEXT_MODEL=gemini-flash-lite-latest
GOOGLE_AI_VISION_MODEL=gemini-3.5-flash
